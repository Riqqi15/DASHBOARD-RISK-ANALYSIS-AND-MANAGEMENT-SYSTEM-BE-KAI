APP_NAME="KAI RAMS UAT"
APP_ENV=uat
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8100

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3309
DB_FORWARD_PORT=3309
DB_DATABASE=rams_uat
DB_USERNAME=rams_uat
DB_PASSWORD=change-this-before-setup
DB_ROOT_PASSWORD=change-this-before-setup

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_FORWARD_PORT=6380
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=rams-imports
REDIS_QUEUE_RETRY_AFTER=1200

FILESYSTEM_DISK=local
MAIL_MAILER=log
PHPMYADMIN_FORWARD_PORT=8081

RAMS_ADMIN_NAME="Admin Pusat UAT"
RAMS_ADMIN_USERNAME=admin.uat
RAMS_ADMIN_EMAIL=
RAMS_ADMIN_PASSWORD=change-this-before-setup
RAMS_SEED_DEMO_ACCOUNTS=true
RAMS_DAOP_PASSWORD=change-this-before-setup
